{
  "name": "@local/dsh-workspace-statuscard",
  "version": "0.1.0",
  "description": "Active-zone-first workspace sidebar plugin for DSH (DeepSeek Harness): pins an Active Sessions zone above the workspace browser, with a configurable activity window, duplicate/return display modes, font size control, and a dedicated settings tab.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "workspace",
    "sidebar",
    "sidebar-extension",
    "active-sessions",
    "session-tracker",
    "statuscard",
    "status-board"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
